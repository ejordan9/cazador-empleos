# ==============================================================================
# CREDENCIALES DEL BOT DE TELEGRAM
# ==============================================================================
# 1. Abre Telegram y busca a @BotFather
# 2. Envía /newbot, dale un nombre y copia el token generado.
# 3. Busca a @userinfobot en Telegram para conocer tu ID numérico de usuario.
# 4. Inicia una conversación con tu propio bot haciendo clic en "Start" / "Iniciar".
# 5. Renombra este archivo como '.env' y completa tus valores:

TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
TELEGRAM_CHAT_ID="123456789"
